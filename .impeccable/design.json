  "components": [
    {
      "name": "Flap Strip (row)",
      "kind": "custom",
      "refersTo": "flap-strip-row",
      "description": "Housed split-flap cells; every board value is set in one.",
      "html": "<span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:#E5383B\">P</span><span class=\"ds-cell\" style=\"color:#E5383B\">M</span><span class=\"ds-cell\" style=\"color:#E5383B\">U</span><span class=\"ds-cell\" style=\"color:#E5383B\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#E5383B\">T</span><span class=\"ds-cell\" style=\"color:#E5383B\">D</span><span class=\"ds-cell\" style=\"color:#E5383B\">I</span><span class=\"ds-cell\" style=\"color:#E5383B\">E</span><span class=\"ds-cell\" style=\"color:#E5383B\">6</span><span class=\"ds-cell\" style=\"color:#E5383B\">&nbsp;</span></span>",
      "css": ".ds-strip{display:inline-flex;gap:1.5px;padding:1.5px;background:#0B0B0D;border-radius:2.5px;} .ds-cell{position:relative;display:inline-flex;align-items:center;justify-content:center;width:11.5px;height:19px;border-radius:1.5px;background:linear-gradient(#242529 0 50%,#1B1C1F 50% 100%);font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-weight:600;font-size:15px;line-height:1;} .ds-cell::after{content:'';position:absolute;left:0;right:0;top:50%;height:0.5px;background:rgba(11,11,13,.55);}"
    },
    {
      "name": "Flap Strip (hero)",
      "kind": "custom",
      "refersTo": "flap-strip-hero",
      "description": "The hero reading at the top of each board, with hinge and axle pins.",
      "html": "<span class=\"ds-hero\"><span class=\"ds-hcell\" style=\"color:#F25A2D\">9</span><span class=\"ds-hcell\" style=\"color:#F25A2D\">3</span><span class=\"ds-hcell\" style=\"color:#F25A2D\">°</span></span>",
      "css": ".ds-hero{display:inline-flex;gap:3px;padding:3px;background:#0B0B0D;border-radius:5px;} .ds-hcell{position:relative;display:inline-flex;align-items:center;justify-content:center;width:38px;height:58px;border-radius:3px;background:linear-gradient(#242529 0 50%,#1B1C1F 50% 100%);font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-weight:600;font-size:50px;line-height:1;} .ds-hcell::after{content:'';position:absolute;left:0;right:0;top:calc(50% - 1px);height:2px;background:#0B0B0D;} .ds-hcell::before{content:'';position:absolute;left:-2px;right:-2px;top:calc(50% - 3px);height:6px;background:linear-gradient(90deg,#5B5E63 2.5px,transparent 2.5px calc(100% - 2.5px),#5B5E63 calc(100% - 2.5px));}"
    },
    {
      "name": "Flap Tabs",
      "kind": "nav",
      "refersTo": "flap-tab",
      "description": "Lamp plus 4-cell strip per option; the selected option's lamp lights amber.",
      "html": "<div class=\"ds-tabs\"><button class=\"ds-tab ds-on\"><i class=\"ds-lamp\"></i><span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:#F2F2F2\">H</span><span class=\"ds-cell\" style=\"color:#F2F2F2\">E</span><span class=\"ds-cell\" style=\"color:#F2F2F2\">A</span><span class=\"ds-cell\" style=\"color:#F2F2F2\">T</span></span></button><button class=\"ds-tab\"><i class=\"ds-lamp\"></i><span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:#A7AAAF\">C</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">P</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">U</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">&nbsp;</span></span></button></div>",
      "css": ".ds-strip{display:inline-flex;gap:1.5px;padding:1.5px;background:#0B0B0D;border-radius:2.5px;} .ds-cell{position:relative;display:inline-flex;align-items:center;justify-content:center;width:11.5px;height:19px;border-radius:1.5px;background:linear-gradient(#242529 0 50%,#1B1C1F 50% 100%);font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-weight:600;font-size:15px;line-height:1;} .ds-cell::after{content:'';position:absolute;left:0;right:0;top:50%;height:0.5px;background:rgba(11,11,13,.55);} .ds-tabs{display:flex;gap:10px;background:#2A2D31;padding:14px;} .ds-tab{display:inline-flex;align-items:center;gap:5px;background:none;border:0;padding:0;cursor:pointer;} .ds-lamp{width:6px;height:6px;border-radius:50%;background:#1E1F23;} .ds-on .ds-lamp{background:#FFB000;box-shadow:0 .5px 3px rgba(255,176,0,.7);} .ds-tab:focus-visible{outline:1px solid #FFB000;outline-offset:2px;}"
    },
    {
      "name": "Quit Button",
      "kind": "button",
      "refersTo": "quit-button",
      "description": "QUIT strip with a key segment; amber on hover.",
      "html": "<button class=\"ds-quit\"><span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:currentColor\">Q</span><span class=\"ds-cell\" style=\"color:currentColor\">U</span><span class=\"ds-cell\" style=\"color:currentColor\">I</span><span class=\"ds-cell\" style=\"color:currentColor\">T</span></span><span class=\"ds-key\">⌘Q</span></button>",
      "css": ".ds-strip{display:inline-flex;gap:1.5px;padding:1.5px;background:#0B0B0D;border-radius:2.5px;} .ds-cell{position:relative;display:inline-flex;align-items:center;justify-content:center;width:11.5px;height:19px;border-radius:1.5px;background:linear-gradient(#242529 0 50%,#1B1C1F 50% 100%);font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-weight:600;font-size:15px;line-height:1;} .ds-cell::after{content:'';position:absolute;left:0;right:0;top:50%;height:0.5px;background:rgba(11,11,13,.55);} .ds-quit{display:inline-flex;gap:3px;align-items:center;background:none;border:0;padding:0;color:#F2F2F2;cursor:pointer;transition:color .12s ease-out;} .ds-key{display:inline-flex;align-items:center;justify-content:center;width:26px;height:19px;border:1.5px solid #0B0B0D;border-radius:2.5px;background:#242529;color:#A7AAAF;font-family:'Barlow Condensed','Arial Narrow',sans-serif;font-weight:600;font-size:13px;transition:color .12s ease-out;} .ds-quit:hover,.ds-quit:hover .ds-key,.ds-quit:focus-visible,.ds-quit:focus-visible .ds-key{color:#FFB000;}"
    },
    {
