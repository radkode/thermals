FE3A3\">7</span><span class=\"ds-cell\" style=\"color:#FFE3A3\">1</span></span><span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:#FFE3A3\">W</span><span class=\"ds-cell\" style=\"color:#FFE3A3\">A</span><span class=\"ds-cell\" style=\"color:#FFE3A3\">R</span><span class=\"ds-cell\" style=\"color:#FFE3A3\">M</span></span></div><div class=\"ds-row\"><i class=\"ds-lamp\"></i><span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:#A7AAAF\">S</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">Y</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">S</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">T</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">E</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">M</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">&nbsp;</span></span><span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:#A7AAAF\">4</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">0</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">3</span></span><span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:#F2F2F2\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#F2F2F2\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#F2F2F2\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#F2F2F2\">&nbsp;</span></span></div></div>",
