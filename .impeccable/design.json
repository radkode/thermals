      "html": "<div class=\"ds-panel\"><div class=\"ds-lbl\">SENSOR</div><div class=\"ds-row\"><i class=\"ds-lamp ds-lit\" style=\"background:#FF8355\"></i><span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:#FF7073\">P</span><span class=\"ds-cell\" style=\"color:#FF7073\">M</span><span class=\"ds-cell\" style=\"color:#FF7073\">U</span><span class=\"ds-cell\" style=\"color:#FF7073\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#FF7073\">T</span><span class=\"ds-cell\" style=\"color:#FF7073\">D</span><span class=\"ds-cell\" style=\"color:#FF7073\">I</span><span class=\"ds-cell\" style=\"color:#FF7073\">E</span><span class=\"ds-cell\" style=\"color:#FF7073\">6</span><span class=\"ds-cell\" style=\"color:#FF7073\">&nbsp;</span></span><span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:#FF7073\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#FF7073\">9</span><span class=\"ds-cell\" style=\"color:#FF7073\">3</span></span><span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:#FF7073\">B</span><span class=\"ds-cell\" style=\"color:#FF7073\">U</span><span class=\"ds-cell\" style=\"color:#FF7073\">R</span><span class=\"ds-cell\" style=\"color:#FF7073\">N</span></span></div><div class=\"ds-row\"><i class=\"ds-lamp\"></i><span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:#A7AAAF\">P</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">M</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">U</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">T</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">D</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">E</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">V</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">1</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">&nbsp;</span></span><span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:#FFE3A3\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#FFE3A3\">7</span><span class=\"ds-cell\" style=\"color:#FFE3A3\">1</span></span><span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:#FFE3A3\">W</span><span class=\"ds-cell\" style=\"color:#FFE3A3\">A</span><span class=\"ds-cell\" style=\"color:#FFE3A3\">R</span><span class=\"ds-cell\" style=\"color:#FFE3A3\">M</span></span></div><div class=\"ds-row\"><i class=\"ds-lamp\"></i><span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:#A7AAAF\">S</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">Y</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">S</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">T</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">E</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">M</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">&nbsp;</span></span><span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:#A7AAAF\">4</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">0</span><span class=\"ds-cell\" style=\"color:#A7AAAF\">3</span></span><span class=\"ds-strip\"><span class=\"ds-cell\" style=\"color:#F2F2F2\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#F2F2F2\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#F2F2F2\">&nbsp;</span><span class=\"ds-cell\" style=\"color:#F2F2F2\">&nbsp;</span></span></div></div>",
