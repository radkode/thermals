      "html": "<div class=\"ds-meter\"><i style=\"background:#E5383B33\"></i><i style=\"background:#F25A2D29\"></i><i style=\"background:#FFB000\"></i><i style=\"background:#FFE3A3\"></i><i style=\"background:#DCE6EE\"></i><i style=\"background:#A5C1DB\"></i><i style=\"background:#E5383B33\"></i><i style=\"background:#F25A2D29\"></i><i style=\"background:#FFB000\"></i><i style=\"background:#FFE3A3\"></i><i style=\"background:#DCE6EE\"></i><i style=\"background:#A5C1DB\"></i><i style=\"background:#E5383B33\"></i><i style=\"background:#F25A2D29\"></i><i style=\"background:#FFB000\"></i><i style=\"background:#FFE3A3\"></i><i style=\"background:#DCE6EE\"></i><i style=\"background:#A5C1DB\"></i><i style=\"background:#E5383B33\"></i><i style=\"background:#F25A2D29\"></i><i style=\"background:#FFB000\"></i><i style=\"background:#FFE3A3\"></i><i style=\"background:#DCE6EE\"></i><i style=\"background:#A5C1DB\"></i><i style=\"background:#E5383B33\"></i><i style=\"background:#F25A2D29\"></i><i style=\"background:#FFB000\"></i><i style=\"background:#FFE3A3\"></i><i style=\"background:#DCE6EE\"></i><i style=\"background:#A5C1DB\"></i></div>",
